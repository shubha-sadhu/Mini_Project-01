# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://127.0.0.1:5500

# ---- MongoDB ----
# Local: mongodb://127.0.0.1:27017/iiest_portal
# Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/iiest_portal
MONGODB_URI=mongodb://127.0.0.1:27017/iiest_portal

# ---- Allowed student email domain ----
ALLOWED_EMAIL_DOMAIN=students.iiests.ac.in

# ---- JWT secrets ----
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_VERIFICATION_SECRET=change_this_verification_secret
JWT_SESSION_SECRET=change_this_session_secret
SESSION_TOKEN_EXPIRES_IN=7d
VERIFICATION_TOKEN_EXPIRES_IN=15m

# ---- OTP ----
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- SMTP (email sending) ----
# For Gmail: use an "App Password", not your normal password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_account@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="IIEST Shibpur Portal <your_sender_account@gmail.com>"
